; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-gamespace-genap"
config/tags=PackedStringArray("gamespace")
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InventoryManager="*uid://b3ca5o41eh74g"
SignalBus="*uid://1l7torykk1j0"
GameManager="*uid://bgcumjkbn6ohl"
SoundPool="*uid://ynin0cgg2p8y"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[global_group]

Player=""
Enemy=""
Coin=""
"Coin Pool"=""
Physics=""
Pushable=""
Kickable=""
Gridmap=""
Tilemaps=""

